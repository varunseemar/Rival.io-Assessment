# PostgreSQL connection string
# Local dev (Docker container on port 5433):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/taskdb?schema=public"
# Production example (Neon): postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me"
# Token lifetime
JWT_EXPIRES_IN="7d"

# Port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# Allowed frontend origin(s) for CORS. Single origin, or comma-separated for
# multiple (e.g. production domain + Vercel preview URLs).
# Example: https://app.vercel.app,https://app-git-main.vercel.app
CORS_ORIGIN="http://localhost:3000"

# Set to true in production (HTTPS) so the auth cookie is marked Secure
COOKIE_SECURE=false
